# Copy to .env and fill in real values. .env is gitignored; NEVER commit secrets.

# --- API-Football ---
APIFOOTBALL_KEY=your-api-football-key-here
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Rate limits / quota (plan-dependent) ---
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_WINDOW_SEC=65
DAILY_QUOTA=75000

# --- Concurrency ---
THREAD_POOL_SIZE=8

# --- Phase B selection ---
LOOKBACK_DAYS=14
SEASON=2025
# Comma-separated league ids; empty = all current leagues
LEAGUE_SUBSET=
FIXTURE_STATUSES=FT,AET,PEN,1H,2H,HT,ET,INT,LIVE,P,BT,SUSP

# --- HTTP retry ---
HTTP_RETRY_MAX_ATTEMPTS=5
HTTP_RETRY_BACKOFF_BASE_SEC=1.0
HTTP_RETRY_BACKOFF_MAX_SEC=30.0

# --- Database ---
# Bronze DB the ingestor reads/writes.
DB_DSN=postgresql://ingestor:ingestor@postgres:5432/ingestor
# Sources (matcher) DB the apifootball_events projection is written INTO (D5).
# Leave empty to disable the projection step. Env-only; never hardcoded.
# Expects the psycopg2 `postgresql://` form; a SQLAlchemy `+psycopg2` dialect
# suffix (as in the matcher's POSTGRES_URL) is accepted and auto-normalized.
MATCHER_DB_DSN=

# --- Logging ---
LOG_LEVEL=INFO
